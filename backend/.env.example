# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/telegram_cloud_db?schema=public"

# Authentication (JWT)
JWT_SECRET="replace-with-a-very-strong-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Encryption Secret Key (AES-256)
# مفتاح عام لتشفير وفك تشفير بيانات تيليجرام الحساسة الخاصة بكل مستخدم في قاعدة البيانات
# (احرص على استخدام مفتاح آمن وقوي 32 حرف على الأقل في بيئة الإنتاج)
ENCRYPTION_SECRET_KEY="super-secret-aes-256-key-change-this-for-production"

# Application Base URL (Public URL)
# رابط الخادم الأساسي الذي يُستخدم في توليد روابط المشاركة العامة للملفات (Share Links).
# في بيئة التطوير المحلية (Development): http://localhost:4000
# في بيئة الإنتاج (Production): يجب تغييره إلى الدومين الفعلي للسيرفر، مثل: https://api.yourdomain.com
APP_BASE_URL="http://localhost:4000"

# Telegram API Base URL
# - الخادم السحابي الافتراضي: https://api.telegram.org (حد التنزيل 20MB)
# - أو سيرفر Telegram Bot API المحلي عبر Docker: http://localhost:8081 (حد الرفع والتنزيل حتى 2GB)
TELEGRAM_API_BASE_URL="http://localhost:8081"

# Maximum File Upload Size in bytes (2GB)
MAX_FILE_SIZE_BYTES=2147483648
